{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "synth-effects-v4"
    },
    "lfos": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/lfo"
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "none"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "distortion"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "drive": {
                    "$ref": "#/$defs/binding"
                  },
                  "mix": {
                    "$ref": "#/$defs/binding"
                  },
                  "output_gain": {
                    "$ref": "#/$defs/binding"
                  }
                }
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "delay"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "time": {
                    "$ref": "#/$defs/binding_ms"
                  },
                  "feedback": {
                    "$ref": "#/$defs/binding"
                  },
                  "mix": {
                    "$ref": "#/$defs/binding"
                  }
                }
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "chorus"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rate": {
                    "$ref": "#/$defs/binding"
                  },
                  "depth": {
                    "$ref": "#/$defs/binding_ms"
                  },
                  "mix": {
                    "$ref": "#/$defs/binding"
                  },
                  "center": {
                    "$ref": "#/$defs/binding_ms"
                  }
                }
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "reverb"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "room": {
                    "$ref": "#/$defs/binding"
                  },
                  "damping": {
                    "$ref": "#/$defs/binding"
                  },
                  "wet": {
                    "$ref": "#/$defs/binding"
                  }
                }
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "compressor"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "threshold": {
                    "$ref": "#/$defs/binding"
                  },
                  "ratio": {
                    "$ref": "#/$defs/binding"
                  },
                  "attack": {
                    "$ref": "#/$defs/binding_ms"
                  },
                  "release": {
                    "$ref": "#/$defs/binding_ms"
                  },
                  "output_gain": {
                    "$ref": "#/$defs/binding"
                  }
                }
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "fir"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "lowpass": {
                    "$ref": "#/$defs/binding"
                  },
                  "highpass": {
                    "$ref": "#/$defs/binding"
                  },
                  "slope": {
                    "$ref": "#/$defs/slope_binding"
                  }
                }
              },
              "fir_bands": {
                "type": "integer",
                "minimum": 2,
                "maximum": 4,
                "description": "FIR bandpass band count. Omitted means the stored single band. Present only when the count exceeds 1; bands 1..count-1 may omit their fir_bandN objects, and an absent active-band object decodes the neutral defaults (gain 1.0, slope 100). fir_band0_gain encodes when band 0's gain binding is non-default for its form: with fir_bands stated the default is the neutral 1.0; in the count-1 stored form any authored state encodes (the zeroed block is not producible and refuses on decode)."
              },
              "fir_band0_gain": {
                "$ref": "#/$defs/binding"
              },
              "fir_band1": {
                "$ref": "#/$defs/fir_band"
              },
              "fir_band2": {
                "$ref": "#/$defs/fir_band"
              },
              "fir_band3": {
                "$ref": "#/$defs/fir_band"
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "fir_band1"
                  ]
                },
                "then": {
                  "required": [
                    "fir_bands"
                  ],
                  "properties": {
                    "fir_bands": {
                      "minimum": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "fir_band2"
                  ]
                },
                "then": {
                  "required": [
                    "fir_bands"
                  ],
                  "properties": {
                    "fir_bands": {
                      "minimum": 3
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "fir_band3"
                  ]
                },
                "then": {
                  "required": [
                    "fir_bands"
                  ],
                  "properties": {
                    "fir_bands": {
                      "minimum": 4
                    }
                  }
                }
              }
            ],
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "fir_multiband"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "lowpass": {
                    "$ref": "#/$defs/binding"
                  },
                  "highpass": {
                    "$ref": "#/$defs/binding"
                  },
                  "slope": {
                    "$ref": "#/$defs/binding"
                  }
                }
              },
              "fir_bands": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "description": "Multi-band FIR band count.  Omitted means the single band.  Present only when the count exceeds 1; a band without a fir_bandN object decodes the neutral defaults (center 0, spread 0, gain 1, slope 100), so an unconfigured band contributes nothing.  Bands beyond the declared count remain zeroed (dormant, inactive)."
              },
              "fir_band0": {
                "$ref": "#/$defs/fir_multiband_band"
              },
              "fir_band1": {
                "$ref": "#/$defs/fir_multiband_band"
              },
              "fir_band2": {
                "$ref": "#/$defs/fir_multiband_band"
              },
              "fir_band3": {
                "$ref": "#/$defs/fir_multiband_band"
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "fir_band1"
                  ]
                },
                "then": {
                  "required": [
                    "fir_bands"
                  ],
                  "properties": {
                    "fir_bands": {
                      "minimum": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "fir_band2"
                  ]
                },
                "then": {
                  "required": [
                    "fir_bands"
                  ],
                  "properties": {
                    "fir_bands": {
                      "minimum": 3
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "fir_band3"
                  ]
                },
                "then": {
                  "required": [
                    "fir_bands"
                  ],
                  "properties": {
                    "fir_bands": {
                      "minimum": 4
                    }
                  }
                }
              }
            ],
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "ring_mod"
              },
              "enabled": {
                "type": "boolean"
              },
              "enable_input": {
                "$ref": "#/$defs/input"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rate": {
                    "$ref": "#/$defs/binding"
                  },
                  "mix": {
                    "$ref": "#/$defs/binding"
                  }
                }
              },
              "feeds": {
                "enum": [
                  "disconnected",
                  "next",
                  "output"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        ]
      }
    },
    "graph_layout": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "input"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width_override": {
                "type": "number",
                "minimum": 0
              },
              "height_override": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "x",
              "y"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "output"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width_override": {
                "type": "number",
                "minimum": 0
              },
              "height_override": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "x",
              "y"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "midi"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width_override": {
                "type": "number",
                "minimum": 0
              },
              "height_override": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "x",
              "y"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "effect"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width_override": {
                "type": "number",
                "minimum": 0
              },
              "height_override": {
                "type": "number",
                "minimum": 0
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
