  "required": [
    "format",
    "effects"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synth_effects_schema.json",
  "title": "Sculptor effects document v4",
  "description": "Named effect bindings and routing; legacy arrays are skipped with warnings. Migrate offline before first launch.",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure",
            "cc"
          ]
        },
        "op": {
          "enum": [
            "add",
            "multiply"
          ]
        },
        "scale": {
          "type": "number"
        },
        "cc_number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      },
      "required": []
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "type": "number"
        },
        "lfo_desc_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "lfo_op": {
          "enum": [
            "add",
            "multiply"
          ]
        },
        "lfo_depth": {
          "type": "number"
        },
        "lfo_depth_source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure"
          ]
        },
        "lfo_rate_source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure"
          ]
        },
        "lfo_rate_scale": {
          "type": "number"
        },
        "inputs": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/input"
          }
        }
      },
      "required": []
    },
    "slope_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "lfo_desc_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "lfo_op": {
          "enum": [
            "add",
            "multiply"
          ]
        },
        "lfo_depth": {
          "type": "number"
        },
        "lfo_depth_source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure"
          ]
        },
        "lfo_rate_source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure"
          ]
        },
        "lfo_rate_scale": {
          "type": "number"
        },
        "inputs": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/input"
          }
        }
      },
      "required": []
    },
    "lfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wave": {
          "enum": [
            "sine",
            "sawtooth"
          ]
        },
        "duty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "period_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "min_value": {
          "type": "number"
        },
        "min_max_delta": {
          "type": "number"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "id",
        "wave",
        "period_ms"
      ]
    },
    "fir_band": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lowpass": {
          "$ref": "#/$defs/binding"
        },
        "highpass": {
          "$ref": "#/$defs/binding"
        },
        "gain": {
          "$ref": "#/$defs/binding"
        },
        "slope": {
          "$ref": "#/$defs/slope_binding"
        }
      },
      "description": "One extra FIR bandpass band: lowpass and highpass cutoff Hz bindings (nonpositive lowpass disables the band), linear gain binding (default 1, clamped to [0,1] at staging) and integer-percent slope binding (default 100)."
    },
    "fir_multiband_band": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {
          "$ref": "#/$defs/binding"
        },
        "spread": {
          "$ref": "#/$defs/binding"
        },
        "gain": {
          "$ref": "#/$defs/binding"
        },
        "slope": {
          "$ref": "#/$defs/slope_binding"
        }
      },
      "description": "One Multi-band FIR band: center and spread cutoff Hz bindings (the coefficient staging derives the band's edges, highpass = center - spread/2 and lowpass = center + spread/2; a band with nonpositive spread or nonpositive center contributes nothing), linear gain binding (default 1, clamped to [0,1] at staging) and integer-percent slope binding (default 100)."
    },
    "binding_ms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lfo_desc_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "lfo_op": {
          "enum": [
            "add",
            "multiply"
          ]
        },
        "lfo_depth_source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure"
          ]
        },
        "lfo_rate_source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure"
          ]
        },
        "lfo_rate_scale": {
          "type": "number"
        },
        "inputs": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/input_ms"
          }
        },
        "base_value_ms": {
          "type": "number"
        },
        "lfo_depth_ms": {
          "type": "number"
        }
      },
      "required": []
    },
    "input_ms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "none",
            "pitch_bend",
            "mod_wheel",
            "channel_pressure",
            "cc"
          ]
        },
        "op": {
          "enum": [
            "add",
            "multiply"
          ]
        },
        "cc_number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "scale_ms": {
          "type": "number"
        }
      },
      "required": []
    }
  }
}
