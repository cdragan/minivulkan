set -euo pipefail

UNAME=$(uname -s)

NOSTDLIB_TARGET=default

case "$UNAME" in
    Linux)                JOBS=$(grep -c ^processor /proc/cpuinfo) ;;
    Darwin)               JOBS=$(sysctl -n hw.ncpu) ;;
    CYGWIN*|MINGW*|MSYS*) JOBS="$NUMBER_OF_PROCESSORS"
                          # On Windows, disable tests when building without stdlib
                          NOSTDLIB_TARGET=build
                          ;;
    *)                    JOBS=2 ;;
esac

echo "Using $JOBS jobs, arch: $(uname -m)"

run()
{
    echo "$$ $@"
    "$@"
}

run rm -rf Out

run make -j $JOBS -k debug=0 stdlib=0 $NOSTDLIB_TARGET

run mkdir -p Out/artifacts
case "$UNAME" in
    Linux)
        run cp Out/release/example{,.map} Out/artifacts
        ;;
    Darwin)
        run cp -r Out/release_nostdlib/example.app Out/artifacts
        run rm -rf Out/artifacts/*.app/Contents/Frameworks
        ;;
    CYGWIN*|MINGW*|MSYS*)
        run cp Out/release_nostdlib/example.exe{,.map} Out/artifacts
        ;;
esac

run make -j $JOBS -k debug=1 stdlib=0 $NOSTDLIB_TARGET

run make -j $JOBS -k debug=1 stdlib=1
